<?xml version="1.0" encoding="UTF-8"?>
<!--
  versions-rules.xml
  Shared configuration for versions-maven-plugin goals such as
  display-plugin-updates, display-property-updates, display-dependency-updates,
  and update-properties.

  Rules here constrain which versions the plugin will suggest, supplementing the
  allowMajorUpdates=false / allowMinorUpdates=true global defaults set in pom.xml.

  See: https://www.mojohaus.org/versions/versions-maven-plugin/version-rules.html
-->
<ruleset comparisonMethod="maven"
         xmlns="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0
                             https://www.mojohaus.org/versions-maven-plugin/xsd/rule-2.0.0.xsd">

    <rules>
        <!--
          Global: ignore pre-release versions (RC, alpha, beta, milestone, SNAPSHOT, CR).
          Only stable releases should be suggested as updates.
          All patterns use (?i) for case-insensitive matching.
        -->
        <rule>
            <ignoreVersions>
                <ignoreVersion type="regex">(?i).*[-.]RC\d*$</ignoreVersion>
                <ignoreVersion type="regex">(?i).*[-.]alpha\d*$</ignoreVersion>
                <ignoreVersion type="regex">(?i).*[-.]beta\d*$</ignoreVersion>
                <ignoreVersion type="regex">(?i).*[-.]M\d+$</ignoreVersion>
                <ignoreVersion type="regex">(?i).*-SNAPSHOT$</ignoreVersion>
                <ignoreVersion type="regex">(?i).*[-.]cr\d*$</ignoreVersion>
            </ignoreVersions>
        </rule>
        <!--
          Apache Camel: stay within the 4.18.x LTS line.
          Camel 4.19.0 and later are built against Spring Boot 4.x / Spring Framework 7
          (4.19.0 and 4.20.0 -> Spring Boot 4.0.x; 4.21.0 and 4.22.0 -> Spring Boot 4.1.x).
          This BOM pins spring-boot.version on the 3.5.x line, so an automated bump past
          4.18.x would pull Spring Boot 4 into izgw-transform.
          Remove this rule when the stack moves to Spring Boot 4.
        -->
        <rule groupId="org.apache.camel" artifactId="*">
            <ignoreVersions>
                <ignoreVersion type="regex">^(?!4\.18\.).*$</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.apache.camel.springboot" artifactId="*">
            <ignoreVersions>
                <ignoreVersion type="regex">^(?!4\.18\.).*$</ignoreVersion>
            </ignoreVersions>
        </rule>

        <!--
          Apache Maven itself: stay within the 3.9.x line.
          The CI/CD pipeline is pinned to 3.9.14; do not suggest 4.x.
        -->
        <rule groupId="org.apache.maven" artifactId="apache-maven">
            <ignoreVersions>
                <ignoreVersion type="regex">^[^3]\..*</ignoreVersion>
                <ignoreVersion type="regex">^3\.[^9]\..*</ignoreVersion>
            </ignoreVersions>
        </rule>


    </rules>

</ruleset>
